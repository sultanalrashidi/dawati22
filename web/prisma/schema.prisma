// Dawati (دعوتي) — core data model.
// See PROJECT_MAP.md at the repo root for the living architecture doc.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  GATE_STAFF
}

enum Locale {
  ar
  en
}

model User {
  id                       String    @id @default(cuid())
  role                     Role      @default(CUSTOMER)
  name                     String
  phone                    String?   @unique
  email                    String?   @unique
  passwordHash             String?
  locale                   Locale    @default(ar)
  phoneVerifiedAt          DateTime?
  isBlocked                Boolean   @default(false)
  /// Failed password attempts on the private admin sign-in route, and the
  /// lockout it earns. Mirrors the door PIN's counters on Event — same threat,
  /// same shape, so the same rules are obvious to whoever reads either.
  adminLoginFailedAttempts Int       @default(0)
  adminLoginLockedUntil    DateTime?
  /// sha256 of a single-use enrollment token issued by `pnpm admin:accounts
  /// enroll`. The ONLY way an admin with no password can sign in: token + SMS
  /// code + a new password, all in one sign-in, before the expiry below.
  adminEnrollmentHash      String?
  adminEnrollmentExpiresAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  ownedEvents            Event[]                  @relation("EventOwner")
  orders                 Order[]
  createdThemes          Theme[]                  @relation("ThemeCreator")
  updatedThemes          Theme[]                  @relation("ThemeUpdater")
  assignedClientThemes   ClientAssignedTheme[]    @relation("ThemeAssignee")
  themeAssignmentsMade   ClientAssignedTheme[]    @relation("ThemeAssigner")
  privateThemeGrants     ThemeAssignment[]        @relation("ThemeGrantee")
  privateThemeGrantsMade ThemeAssignment[]        @relation("ThemeGranter")
  gateStaffProfile       GateStaff?
  gateAssignmentsMade    GateStaffAssignment[]    @relation("GateAssigner")
  notifications          Notification[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  sessions               Session[]
  guestManagementAsks    GuestManagementRequest[] @relation("GuestMgmtRequester")
  guestManagementDone    GuestManagementRequest[] @relation("GuestMgmtResolver")
  designRequests         CustomDesignRequest[]    @relation("DesignRequester")
  designsDelivered       CustomDesignRequest[]    @relation("DesignDeliverer")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  VERIFY_PHONE
}

model OtpCode {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  /// sha256 of the one-time grant issued when this code verified a phone with
  /// no account yet. The name step spends the grant, never the code again.
  signupGrantHash      String?   @unique
  signupGrantExpiresAt DateTime?
  signupGrantUsedAt    DateTime?

  @@index([phone, purpose])
}

// ---------------------------------------------------------------------------
// Plans & orders (packages must be purchased before an event can be created)
// ---------------------------------------------------------------------------

enum PlanStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

/// What one invitation buys. WITH_QR includes the scannable entry pass and the
/// door check-in; NO_QR is the same invitation without a code to scan.
enum InvitationTier {
  NO_QR
  WITH_QR
}

/// The live price list — exactly two rows, one per tier. The matching row is
/// COPIED onto the Order at purchase, so this table is settings, never history:
/// re-pricing tomorrow must not re-price what somebody already bought.
model PricingRate {
  id        String         @id @default(cuid())
  tier      InvitationTier @unique
  unitPrice Decimal        @db.Decimal(10, 2)
  currency  String         @default("SAR")
  updatedAt DateTime       @updatedAt
}

/// Legacy fixed packages. Retired in favour of per-invitation pricing and kept
/// forever so historical orders can still name what was sold; no new order
/// points at one. Do NOT edit invitationCount on a live row — see Order.
model Plan {
  id                     String     @id @default(cuid())
  name                   String
  nameAr                 String
  invitationCount        Int
  price                  Decimal    @db.Decimal(10, 2)
  currency               String     @default("SAR")
  maxGuestsPerInvitation Int?
  status                 PlanStatus @default(ACTIVE)
  sortOrder              Int        @default(0)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  orders Order[]

  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  MOYASAR
  /// Nothing to charge: a discount code took the whole amount, so the order is
  /// settled at once without a card.
  FREE
}

/// Percent off an order, or a fixed number of riyals off it.
enum DiscountKind {
  PERCENT
  FIXED
}

/// A discount code the owner creates in the admin and hands out. It applies to
/// invitation orders only, entered at checkout.
///
/// Uses are not stored: they are counted from the PAID orders carrying the
/// code, so a declined or abandoned checkout never spends one, and there is no
/// counter to drift away from the orders it is meant to count.
model DiscountCode {
  id        String       @id @default(cuid())
  /// Upper-case letters, digits and dashes. What the customer types is folded
  /// to the same shape before it is looked up.
  code      String       @unique
  kind      DiscountKind
  /// 1-100 for PERCENT; riyals for FIXED.
  value     Decimal      @db.Decimal(10, 2)
  /// Paid orders that may carry it. Null means no limit.
  maxUses   Int?
  /// The window it works in; either end may be left open.
  startsAt  DateTime?
  endsAt    DateTime?
  /// The owner's off switch.
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]
}

/// What an order buys. Invitations are the product; a custom design is a
/// one-off service fee. They must stay distinguishable, because an order that
/// buys invitations is spendable on a new event and one that buys a design is
/// not — see `listEligibleOrders`.
enum OrderKind {
  INVITATIONS
  CUSTOM_DESIGN
}

model Order {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  kind            OrderKind       @default(INVITATIONS)
  /// The legacy package this was bought from. Null for every order placed under
  /// per-invitation pricing.
  planId          String?
  plan            Plan?           @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// Invitations bought — this event's guest capacity, snapshotted at purchase.
  /// Authoritative once set; backfilled from Plan.invitationCount for old rows
  /// so capacity stopped being a live read of an editable settings table.
  invitationCount Int?
  /// Whether these invitations carry a scannable QR entry pass.
  tier            InvitationTier?
  /// Price of ONE invitation at purchase time. Null on legacy package orders,
  /// which were priced as a bundle — display always reads `amount`, never
  /// unitPrice x count, or every historical order re-prices wrongly.
  unitPrice       Decimal?        @db.Decimal(10, 2)
  /// Total actually charged. The only value Moyasar is reconciled against.
  amount          Decimal         @db.Decimal(10, 2)
  /// The code applied at checkout. Restrict: a code that has touched an order
  /// is switched off, never deleted, so the order can still say where its
  /// discount came from.
  discountCodeId  String?
  discountCode    DiscountCode?   @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  /// Riyals the code took off, already subtracted from `amount`; the price
  /// before the code is amount + discountAmount.
  discountAmount  Decimal?        @db.Decimal(10, 2)
  /// While in the future, this unpaid order holds one of its code's `maxUses`
  /// — reserved when the discounted checkout is presented, renewed while it
  /// is shown, spent when the order becomes PAID.
  discountReservedUntil DateTime?
  currency        String          @default("SAR")
  status          OrderStatus     @default(PENDING)
  provider        PaymentProvider @default(MOCK)
  providerRef     String?         @unique
  idempotencyKey  String          @unique
  paidAt          DateTime?
  /**
   * INTENT: the draft this order was raised to activate. Deliberately NOT
   * unique — a declined card followed by a retry may raise a second order
   * against the same draft. SETTLEMENT is the other side of the pair,
   * Event.orderId, which stays unique so only one order can ever activate it.
   * Restrict, not SetNull: a draft with money in flight must not be deletable.
   */
  draftEventId    String?
  draftEvent      Event?          @relation("OrderDraft", fields: [draftEventId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  event         Event?
  designRequest CustomDesignRequest?

  @@index([userId, status])
  @@index([draftEventId])
  @@index([discountCodeId, status])
}

// ---------------------------------------------------------------------------
// Themes (data-driven; see PROJECT_MAP.md "Theme engine")
// ---------------------------------------------------------------------------

enum ThemeStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

/// Which renderer draws the theme. LEGACY themes are the hand-coded designs
/// (`config.card.style`); BUILDER themes are authored entirely in the admin
/// Theme Builder and replayed from ThemeLayout/ThemeTypography/ThemeVariant.
/// The two coexist so shipping the builder never touches a working design.
enum ThemeEngine {
  LEGACY
  BUILDER
}

/// What the design is for. Distinct from `Theme.category`, which is the visual
/// style (classic/luxury/botanical/...) the gallery filters on.
enum ThemeOccasion {
  WEDDING
  ENGAGEMENT
  BIRTHDAY
  BACHELORETTE
}

/// PUBLIC themes appear in every customer's gallery; PRIVATE ones only for the
/// customers named in ThemeAssignment.
enum ThemeVisibility {
  PUBLIC
  PRIVATE
}

model Theme {
  id            String          @id @default(cuid())
  slug          String          @unique
  version       Int             @default(1)
  name          String
  nameAr        String
  category      String
  description   String?
  descriptionAr String?
  config        Json
  coverImageUrl String?
  status        ThemeStatus     @default(DRAFT)
  engine        ThemeEngine     @default(LEGACY)
  occasion      ThemeOccasion   @default(WEDDING)
  visibility    ThemeVisibility @default(PUBLIC)
  thumbnailUrl  String?
  isCustom      Boolean         @default(false)
  archivedAt    DateTime?
  createdById   String
  createdBy     User            @relation("ThemeCreator", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?           @relation("ThemeUpdater", fields: [updatedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assets             ThemeAsset[]
  variants           ThemeVariant[]
  layout             ThemeLayout?
  typography         ThemeTypography?
  assignments        ThemeAssignment[]
  events             Event[]
  clientAssignments  ClientAssignedTheme[]
  designInspirations CustomDesignRequest[] @relation("DesignInspiration")
  designDeliveries   CustomDesignRequest[] @relation("DesignDelivery")

  @@index([status])
  @@index([slug])
  @@index([engine, status])
}

/// One color option of a design. Variants share the parent's layout and
/// typography — an admin duplicates a variant and swaps only its images, which
/// is why `layoutOverrides` is sparse and usually empty.
model ThemeVariant {
  id              String   @id @default(cuid())
  themeId         String
  theme           Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  nameAr          String
  /// Arabic color label the gallery's color filter groups on, e.g. "كحلي".
  colorTag        String?
  /// VariantPalette — validated by paletteSchema on read and write.
  palette         Json
  /// Sparse per-layer transform overrides, keyed by layer id. Empty by default.
  layoutOverrides Json?
  sortOrder       Int      @default(0)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assets ThemeAsset[]
  events Event[]

  @@unique([themeId, slug])
  @@index([themeId])
}

/// An uploaded image. `slot` is free-form on purpose (see lib/themes/builder/
/// slots.ts): new kinds of art never need a schema change. A row with a null
/// variantId is shared by every variant of the theme.
model ThemeAsset {
  id        String        @id @default(cuid())
  themeId   String
  theme     Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ThemeVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  slot      String
  url       String
  /// Blob store pathname, kept so deleting the row can delete the object too.
  blobPath  String?
  width     Int?
  height    Int?
  fileSize  Int?
  mimeType  String
  createdAt DateTime      @default(now())

  @@index([themeId])
  @@index([variantId])
  @@index([themeId, slot])
}

/// The visual arrangement: scenes, layers, transforms, animation. One document
/// per theme, shared by every variant. See lib/themes/builder/types.ts.
model ThemeLayout {
  id        String   @id @default(cuid())
  themeId   String   @unique
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  /// LayoutDoc
  doc       Json
  updatedAt DateTime @updatedAt
}

/// Named font roles a theme's text layers point at, so one change re-styles
/// every layer using that role.
model ThemeTypography {
  id        String   @id @default(cuid())
  themeId   String   @unique
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  /// TypographyDoc
  doc       Json
  updatedAt DateTime @updatedAt
}

/// Grants one customer access to a PRIVATE theme. Distinct from
/// ClientAssignedTheme, which pins a theme onto one specific event.
model ThemeAssignment {
  id           String   @id @default(cuid())
  themeId      String
  theme        Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ThemeGrantee", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("ThemeGranter", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([themeId, userId])
  @@index([userId])
  @@index([themeId])
}

/// Font library. BUILTIN families are the ones bundled through next/font and
/// optimised at build time; GOOGLE families are added by an admin at runtime
/// and loaded from the Google Fonts CSS API — no code change, no deploy.
enum ThemeFontSource {
  BUILTIN
  GOOGLE
}

model ThemeFont {
  id        String          @id @default(cuid())
  family    String          @unique
  label     String
  labelAr   String?
  source    ThemeFontSource @default(GOOGLE)
  /// Comma-separated weights to request, e.g. "400,500,700".
  weights   String          @default("400,700")
  /// Comma-separated Google Fonts subsets, e.g. "arabic,latin".
  subsets   String          @default("arabic,latin")
  /// Set for BUILTIN families: the CSS variable next/font already declares.
  cssVar    String?
  isArabic  Boolean         @default(false)
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([isActive, sortOrder])
}

model ClientAssignedTheme {
  id           String   @id @default(cuid())
  themeId      String
  theme        Theme    @relation(fields: [themeId], references: [id])
  userId       String?
  user         User?    @relation("ThemeAssignee", fields: [userId], references: [id])
  eventId      String?  @unique
  event        Event?   @relation(fields: [eventId], references: [id])
  assignedById String
  assignedBy   User     @relation("ThemeAssigner", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

enum EventType {
  WEDDING
  ENGAGEMENT
  GRADUATION
  BIRTHDAY
  ANNIVERSARY
  CORPORATE
  OTHER
}

enum EventGuestManagementMode {
  SELF
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// What opens the invitation text: the verse (basmala + Qur'anic verse),
/// a dua (basmala + blessing), the basmala alone, or nothing. The Arabic
/// strings live in src/lib/themes/builder/content.ts, not in the database.
enum InvitationOpening {
  VERSE
  DUA
  BASMALA
  NONE
}

/// How the host line (سطر الداعي) is produced: composed from the two mothers'
/// kunyas (TEMPLATE) or typed verbatim by the customer (FREE).
enum HostMode {
  TEMPLATE
  FREE
}

/// How the couple's given names are joined on the invitation. The bride is
/// always first — this is a women's-section invitation.
enum CoupleFormat {
  ALA
  WAW
  BRIDE_FOCUS
}

model Event {
  id                    String                   @id @default(cuid())
  /**
   * Null while this is an anonymous draft — someone designing an invitation
   * before signing in. Set when she signs in (the draft is claimed onto her
   * account) and never cleared afterwards. `onDelete: Restrict` is written out
   * because making a relation optional would otherwise silently flip Prisma's
   * default action to SetNull, quietly turning a paid customer's event into an
   * ownerless row the moment anyone deleted the User.
   */
  ownerId               String?
  owner                 User?                    @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /**
   * THE ACTIVATION PREDICATE. Null = an unpaid draft; set = paid and live.
   * Deliberately not `status`, which has never been written in production and
   * would need a backfill across every live wedding to mean anything.
   * Still @unique: one paid order buys at most one event, and Postgres allows
   * unlimited NULLs under a unique index, so drafts never collide.
   * Set exactly once, inside the activation compare-and-set at payment.
   */
  orderId               String?                  @unique
  order                 Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /**
   * Invitations granted by hand, on top of what the order bought.
   *
   * Capacity is `Order.invitationCount + this`. It is a separate column and
   * not an edit to the order for one reason: `Order.invitationCount` is the
   * figure Moyasar payments are reconciled against, so raising it would make
   * the order lie about the amount that was actually charged. And it cannot
   * be a second order either — `orderId` above is @unique, so an event can
   * never hold one.
   *
   * Keeping them apart also keeps the two facts readable side by side: what
   * she paid for, and what the owner gave her. Every change here is written to
   * AuditLog, because it is capacity with no money against it.
   */
  extraInvitationCount  Int                      @default(0)
  type                  EventType
  name                  String
  /// English names are OPTIONAL since the women's-invitation redesign; ""
  /// means "not given" and the Arabic name stands in everywhere (seal, OG
  /// image, metadata). Kept NOT NULL so CoupleInput/couplesFor need no change.
  groomNameEn           String                   @default("")
  brideNameEn           String                   @default("")
  groomNameAr           String?
  groomFamilyAr         String?
  brideNameAr           String?
  brideFamilyAr         String?
  /// Legacy — no longer written by the form. Still read as the `greeting` content field.
  familiesGreetingAr    String?
  /// Optional extra text under the composed invitation line ("نص إضافي").
  invitationTextAr      String                   @default("")
  /// The opening (الافتتاحية) printed above the host line.
  openingKind           InvitationOpening        @default(VERSE)
  /// TEMPLATE composes the host line from the two mothers; FREE prints hostLineAr.
  hostMode              HostMode                 @default(TEMPLATE)
  /// Kunya of the groom's mother, e.g. "أم عبدالله" (hostMode TEMPLATE).
  groomMotherAr         String?
  /// Kunya of the bride's mother, e.g. "أم سعد" (hostMode TEMPLATE).
  brideMotherAr         String?
  /// The whole host line, verbatim (hostMode FREE).
  hostLineAr            String?
  /// How the couple's given names are joined: "نورة على فيصل" / "نورة و فيصل" / bride on her own line.
  coupleFormat          CoupleFormat             @default(ALA)
  /// The closing line (الخاتمة), e.g. "بحضوركم تكتمل فرحتنا". Null = the default preset.
  closingAr             String?
  eventDate             DateTime
  locationName          String
  /**
   * City/area the venue is in, e.g. "جدة" — shown alongside locationName on the guest page.
   */
  regionName            String?
  mapUrl                String?
  coverImageUrl         String?
  musicYoutubeId        String?
  /**
   * true = starts playing right when the guest opens the invitation; false = guest must tap the music button.
   */
  musicAutoplay         Boolean                  @default(false)
  /**
   * Ordered list of { labelAr, time } — event-day schedule, e.g. reception/procession/dinner.
   */
  scheduleItems         Json?
  /**
   * Free text, one note per line — e.g. "no children", dress code.
   */
  notesAr               String?
  /// Standard guest notes, prepended to the notesAr lines when on.
  noteNoPhotos          Boolean                  @default(false)
  noteNoChildren        Boolean                  @default(false)
  noteShowPass          Boolean                  @default(false)
  /**
   * Short human-typeable code the owner can read out to a door guard — generated once at creation.
   */
  referenceCode         String?                  @unique
  /**
   * sha256 of a customer-set PIN, gates the no-login /gate-access scanner. Null = that access method is off.
   */
  gatePinHash           String?
  /// The door team's link (`/gate-link/<token>`): opening it grants a door
  /// session for this event, no PIN typed. 256-bit, unguessable; null = off.
  /// Replacing or clearing it also ends every open door session.
  gateLinkToken         String?                  @unique
  gatePinFailedAttempts Int                      @default(0)
  gatePinLockedUntil    DateTime?
  themeId               String
  theme                 Theme                    @relation(fields: [themeId], references: [id])
  /// Which colour of a BUILDER theme the customer chose. Null for LEGACY
  /// themes (each of their colours is its own Theme row) and as a fallback to
  /// the design's default colour. SetNull rather than Cascade: deleting a
  /// colour must not delete somebody's event — it falls back to the default.
  themeVariantId        String?
  themeVariant          ThemeVariant?            @relation(fields: [themeVariantId], references: [id], onDelete: SetNull)
  guestManagementMode   EventGuestManagementMode @default(SELF)
  /**
   * Whether this event's invitations carry a scannable QR entry pass — a
   * snapshot of the order's tier taken at creation, so the hottest public
   * query (`getInvitationByLinkToken`) never has to join the order.
   * The default is `true` ONLY so that events created before per-invitation
   * pricing keep the pass they were sold. It is the permissive value: it grants
   * the paid feature. Every new event must therefore set this column
   * EXPLICITLY from its order's tier — see createEventWithUniqueReferenceCode.
   * Leaving it to the default would hand a NO_QR customer the WITH_QR product.
   */
  hasQr                 Boolean                  @default(true)
  rsvpRequired          Boolean                  @default(true)
  /**
   * false = each guest's seat count is fixed to what the owner set; guests can't raise it on the RSVP form.
   */
  allowGuestPartySize   Boolean                  @default(true)
  status                EventStatus              @default(DRAFT)
  /**
   * sha256 of the raw `dawati_draft` cookie token — the capability handle that
   * lets an anonymous visitor come back to her own draft. The URL itself
   * carries no secret, so a copied /draft link opens nothing. Cleared when the
   * draft is claimed by a signed-in user; always null on an activated event.
   */
  draftTokenHash        String?                  @unique
  /**
   * Opens the shareable watermarked preview ("show it to my mother before I
   * pay"). Separate from the owner's own private preview and from any guest
   * link: it is never passed as `linkToken`, so RSVP and the door scanner stay
   * inert on it. Capped at PREVIEW_SHARE_VIEWER_LIMIT distinct viewers, counted
   * in PreviewShareView.
   */
  previewShareToken     String?                  @unique
  /**
   * Opens the customer's own real invitation after payment ("إرسال دعوة
   * تجريبية"). Backed by no Guest row on purpose, so it never consumes a paid
   * slot; like previewShareToken it is never rendered as `linkToken`.
   */
  selfPreviewToken      String?                  @unique
  /**
   * Null = the names, date and venue are still editable by the customer. A
   * timestamp = the first invitation actually reached a guest and the data is
   * frozen for her. Support's admin writer deliberately ignores this — fixing a
   * misspelt name after invitations went out is the whole point of that path.
   */
  detailsLockedAt       DateTime?
  /**
   * What she picked on /plans before she had a draft, carried forward so the
   * pay step opens pre-filled. Pure UI intent with no authority: the numbers
   * that are charged and enforced come from the Order alone.
   */
  intendedTier          InvitationTier?
  intendedCount         Int?
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  couples                EventCouple[]
  guests                 Guest[]
  invitations            Invitation[]
  gateStaffAssignments   GateStaffAssignment[]
  clientAssignedTheme    ClientAssignedTheme?
  checkInLogs            CheckInLog[]
  guestManagementRequest GuestManagementRequest?
  designRequest          CustomDesignRequest?
  gateAccessSessions     GateAccessSession[]
  /// Orders raised to activate this draft — see Order.draftEventId for why this is a list.
  pendingOrders          Order[]                 @relation("OrderDraft")
  previewShareViews      PreviewShareView[]

  @@index([ownerId])
  @@index([status])
}

/// One attempt to start a free draft, kept only long enough to rate-limit.
///
/// Starting a draft is the product's first unauthenticated write to a core
/// table, so it needs the throttle that every other anonymous entry point has.
/// Counting rows in a window is the same shape requestOtp already uses.
///
/// Deliberately a separate table rather than an ipHash column on the draft
/// itself: attempts must survive the draft being deleted (otherwise "create,
/// delete, repeat" walks straight through the limit), and an abandoned
/// invitation should not carry a visitor's network address around with it for
/// thirty days.
model DraftCreationAttempt {
  id        String   @id @default(cuid())
  /// sha256 of the client address — never the address itself.
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

/// One distinct viewer of an event's shareable watermarked preview.
///
/// `viewerKey` is a random id we set as a cookie on that viewer's browser the
/// first time they open the link, so re-opening it costs nothing — the cap is
/// three PEOPLE, not three page loads. It is a soft limit by nature (a cleared
/// cookie is a new viewer), and it is not the thing preventing a free preview
/// being used as a real invitation: the watermark, the absent RSVP and the
/// absent QR are.
model PreviewShareView {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime @default(now())

  @@unique([eventId, viewerKey])
  @@index([eventId])
}

/// One groom+bride pair announced by an event. A joint wedding carries several,
/// ordered by `sortOrder`. The first row mirrors Event's own groom/bride
/// columns, which stay the primary couple for every existing read (link
/// preview, seal monogram, opengraph card) — this table only *adds* the rest.
model EventCouple {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder     Int      @default(0)
  groomNameEn   String   @default("")
  brideNameEn   String   @default("")
  groomNameAr   String?
  groomFamilyAr String?
  brideNameAr   String?
  brideFamilyAr String?
  createdAt     DateTime @default(now())

  @@index([eventId])
}

/**
 * Login-free gate-guard grant: reference code + PIN in, this session out, scoped to one event.
 */
model GateAccessSession {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Guests, invitations, RSVP
// ---------------------------------------------------------------------------

model Guest {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nameAr         String
  phone          String?
  allowedCount   Int      @default(1)
  checkedInCount Int      @default(0)
  isBlocked      Boolean  @default(false)
  /// Groups one pasted/imported list, so a bad import is one undo rather than
  /// three hundred taps, and a double-submitted import is detectable.
  importBatchId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invitation  Invitation?
  checkInLogs CheckInLog[]

  @@index([eventId])
  @@index([eventId, importBatchId])
}

enum InvitationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  BLOCKED
  CANCELLED
  VALID
  PARTIALLY_USED
  FULLY_USED
  EXPIRED
}

model Invitation {
  id          String           @id @default(cuid())
  guestId     String           @unique
  guest       Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      InvitationStatus @default(DRAFT)
  linkToken   String           @unique
  qrToken     String           @unique
  viewedAt    DateTime?
  respondedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rsvps Rsvp[]

  @@index([eventId])
  @@index([linkToken])
  @@index([qrToken])
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  status       RsvpStatus
  respondedAt  DateTime   @default(now())
  ipHash       String?
  userAgent    String?
  guestNameAr  String?
  guestPhone   String?
  /**
   * How many of the guest's allowed seats are actually attending — capped at Guest.allowedCount.
   */
  partySize    Int?
  messageAr    String?

  @@index([invitationId])
}

// ---------------------------------------------------------------------------
// Gate staff & check-in
// ---------------------------------------------------------------------------

model GateStaff {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  assignments GateStaffAssignment[]
  checkInLogs CheckInLog[]
}

model GateStaffAssignment {
  id           String    @id @default(cuid())
  gateStaffId  String
  gateStaff    GateStaff @relation(fields: [gateStaffId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User      @relation("GateAssigner", fields: [assignedById], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([gateStaffId, eventId])
  @@index([eventId])
}

enum CheckInResult {
  SUCCESS
  DENIED_FULL
  DENIED_BLOCKED
  DENIED_CANCELLED
  DENIED_EXPIRED
  DENIED_UNCONFIRMED
  DENIED_INVALID
}

model CheckInLog {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       Guest?        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  /// Null when the door was opened without a staff account: the shared gate
  /// PIN the customer gives her own organisers, or support scanning from the
  /// admin side. It was NOT NULL until now, and that is the whole reason the
  /// PIN door wrote no log at all — a PIN session has no GateStaff row to
  /// point at, so the write had to be skipped rather than attributed.
  gateStaffId String?
  gateStaff   GateStaff?    @relation(fields: [gateStaffId], references: [id])
  seatsBefore Int?
  seatsAfter  Int?
  result      CheckInResult
  createdAt   DateTime      @default(now())

  @@index([eventId])
  @@index([guestId])
}

// ---------------------------------------------------------------------------
// Guest management hand-off, notifications, audit
// ---------------------------------------------------------------------------

enum GuestManagementRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model GuestManagementRequest {
  id            String                       @id @default(cuid())
  eventId       String                       @unique
  event         Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                         @relation("GuestMgmtRequester", fields: [requestedById], references: [id])
  status        GuestManagementRequestStatus @default(PENDING)
  notes         String?
  resolvedById  String?
  resolvedBy    User?                        @relation("GuestMgmtResolver", fields: [resolvedById], references: [id])
  createdAt     DateTime                     @default(now())
  resolvedAt    DateTime?
}

/// A custom design's life, start to finish. The customer only ever sees NEW →
/// IN_PROGRESS → READY → PAID; CHANGES_REQUESTED is READY sent back for another
/// round, and APPROVED is the gap between "I like it" and the money arriving.
enum DesignRequestStatus {
  NEW
  IN_PROGRESS
  READY
  CHANGES_REQUESTED
  APPROVED
  PAID
  CANCELLED
}

/// A customer asking the team to design something that is not in the catalogue.
///
/// One per event, because the design is FOR that wedding and delivery means
/// pointing that event at the finished theme. The brief deliberately reuses the
/// gallery's own colour and style vocabulary rather than inventing a second one.
model CustomDesignRequest {
  id        String              @id @default(cuid())
  /// Short human-readable code the customer quotes over WhatsApp when sending
  /// inspiration images — the only way to match a photo to a request.
  reference String              @unique
  userId    String
  user      User                @relation("DesignRequester", fields: [userId], references: [id], onDelete: Cascade)
  eventId   String              @unique
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    DesignRequestStatus @default(NEW)

  /// The brief. Colour tags and the style key are the gallery's values.
  colorTags          String[]
  styleCategory      String?
  /// An existing design the customer pointed at as "close to what I want".
  inspirationThemeId String?
  inspirationTheme   Theme?   @relation("DesignInspiration", fields: [inspirationThemeId], references: [id], onDelete: SetNull)
  notes              String?

  /// The finished design. Set when the team marks the request READY; it is what
  /// the customer previews, and what the event switches to once paid.
  deliveredThemeId String?
  deliveredTheme   Theme?  @relation("DesignDelivery", fields: [deliveredThemeId], references: [id], onDelete: SetNull)
  /// Who delivered it — carried onto the ClientAssignedTheme record at payment,
  /// which needs an actor and cannot use the customer.
  deliveredById    String?
  deliveredBy      User?   @relation("DesignDeliverer", fields: [deliveredById], references: [id])

  /// The fee, snapshotted when the request is made so re-pricing the service
  /// never re-prices a request already in flight.
  priceSar Decimal @db.Decimal(10, 2)
  /// Created only when the customer approves — the whole point of the flow is
  /// that nothing is owed until then.
  orderId  String? @unique
  order    Order?  @relation(fields: [orderId], references: [id])

  /// How many times the customer sent it back. Policy lives in the UI copy.
  revisionCount Int     @default(0)
  /// The customer's latest "change this" note, and the team's reply.
  revisionNote  String?
  adminNote     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?
  paidAt      DateTime?

  @@index([status])
  @@index([userId])
}

/// Operational switches an admin flips from the panel, so that changing one
/// never means editing a Vercel environment variable and redeploying.
///
/// Deliberately a key/value table rather than a column per setting: these are
/// switches, not data, and each new one should cost a row, not a migration.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  titleAr   String
  bodyAr    String
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
